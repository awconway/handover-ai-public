OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.5
OPENAI_MODEL_REASONING_EFFORT=medium
OPENAI_REQUEST_TIMEOUT_MS=60000
OPENAI_REQUEST_MAX_ATTEMPTS=2
PORT=8787
PUBLIC_ORIGIN=http://localhost:8787
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://app:app@localhost:5432/handover
AUDIO_STORAGE_BACKEND=filesystem
AUDIO_STORAGE_DIR=uploads/audio
RETAIN_UPLOADED_AUDIO_AFTER_TRANSCRIPTION=true
LOCAL_FIRST_PROCESSING_POLICY=optional
LOCAL_PRIVACY_API_URL=http://127.0.0.1:8789
LOCAL_PRIVACY_SHARED_SECRET=replace-with-a-long-random-local-privacy-token
LOCAL_PRIVACY_TIMEOUT_MS=1260000
LOCAL_PRIVACY_STT_RUNTIME=mlx
LOCAL_PRIVACY_OFFLINE=true
# AZURE_STORAGE_CONNECTION_STRING=
AZURE_AUDIO_CONTAINER_NAME=handover-temp-audio
AZURE_AUDIO_BLOB_PREFIX=dev
MOCK_TRANSCRIPTION=false
SESSION_SECRET=replace-with-a-long-random-secret
HANDOVER_SHEET_STORAGE_BACKEND=filesystem
HANDOVER_SHEET_STORAGE_DIR=uploads/handover-sheets
# AZURE_SHEET_CONTAINER_NAME=handover-sheets
# AZURE_SHEET_BLOB_PREFIX=dev
QUEUE_POLL_INTERVAL_MS=2000
HANDOVER_DSPY_TIMEOUT_MS=120000
USABILITY_ANALYTICS_ENABLED=true
USABILITY_ANALYTICS_RETENTION_DAYS=90
HANDOVER_DSPY_API_URL=http://127.0.0.1:8000
HANDOVER_DSPY_SHARED_SECRET=replace-with-a-long-random-worker-token
