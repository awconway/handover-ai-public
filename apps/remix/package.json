{
  "name": "@handover/remix",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm hmr",
    "hmr": "DOTENV_CONFIG_PATH=../../.env NODE_ENV=development node hmr.ts",
    "dev:server": "DOTENV_CONFIG_PATH=../../.env NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "start": "DOTENV_CONFIG_PATH=../../.env NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "cd ../.. && NODE_ENV=test apps/remix/node_modules/.bin/remix test --config apps/remix/remix.json",
    "test:coverage": "cd ../.. && NODE_ENV=test apps/remix/node_modules/.bin/remix test --config apps/remix/remix.json --coverage",
    "typecheck": "tsc --noEmit",
    "routes": "remix routes",
    "doctor": "remix doctor",
    "migrate": "DOTENV_CONFIG_PATH=../../.env node --import remix/node-tsx db/migrate.ts",
    "worker": "DOTENV_CONFIG_PATH=../../.env NODE_ENV=production node --import remix/node-tsx worker.ts",
    "worker:watch": "DOTENV_CONFIG_PATH=../../.env NODE_ENV=development node --watch --import remix/node-tsx worker.ts",
    "report:usability": "DOTENV_CONFIG_PATH=../../.env node --import remix/node-tsx app/data/usability-report-cli.ts"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@remix-run/ui": "0.12.1",
    "dotenv": "^17.2.3",
    "nanoid": "^5.1.6",
    "openai": "^6.9.1",
    "pg": "^8.20.0",
    "remix": "3.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "playwright": "^1.55.0",
    "typescript": "latest"
  },
  "license": "MIT"
}
